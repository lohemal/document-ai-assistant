{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocAid Sandbox",
  "identifier": "kr.school.docaid.sandbox",
  "app": {
    "windows": [
      {
        "title": "업무자료 AI 도우미 — 연습용 (실제 자료와 따로 저장됩니다)",
        "width": 1360,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/kr.school.docaid.sandbox/files/*"]
      }
    }
  }
}
