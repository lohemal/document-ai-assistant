{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 기본 권한",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://ollama.com/*"
        },
        {
          "url": "https://github.com/lohemal/*"
        }
      ]
    }
  ]
}
